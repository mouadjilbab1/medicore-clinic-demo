# MediCore Clinic Management System - Production Environment Configuration
APP_NAME="MediCore Clinic"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clinic.yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Relational Database Engine (MySQL 8.0+ / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medicore_clinic
DB_USERNAME=medicore_user
DB_PASSWORD=YourStrongDatabasePasswordHere

# Session & Cache (Database driven - zero external Redis dependency required)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Outgoing Mail Delivery (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@yourdomain.com"
MAIL_FROM_NAME="MediCore Clinic Notification System"

# Vite Asset Optimization
VITE_APP_NAME="${APP_NAME}"
